# Supabase project URL, for example: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe anon key. Use only if you later add authenticated client-side reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for route handlers/workers. Never expose this in browser bundles.
SUPABASE_SERVICE_ROLE_KEY=
